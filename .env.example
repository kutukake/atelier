# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (atelier-db)
MYSQL_DATABASE=atelier
MYSQL_USER=atelier
MYSQL_PASSWORD=atelier_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST=db
MYSQL_PORT=3306

# minimo (SALON TOOL) - スナップフォト自動投稿用
MINIMODEL_SALON_ID=your_salon_id
MINIMODEL_PASSWORD=your_password

# Gemini API
# 質問文・フッタ文言は config/gemini_prompts.py にまとめてある
GEMINI_API_KEY=your_api_key
